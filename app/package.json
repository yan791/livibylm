{
  "name": "livi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node scripts/preparar-api.mjs && wrangler d1 migrations apply livi --local && wrangler dev --port 8787",
    "build": "tsc -p . && vite build",
    "verificar": "tsc -p . && tsc -p worker && tsc -p test",
    "test": "vitest run",
    "publicar": "tsc -p . && tsc -p worker && tsc -p test && vitest run && vite build --outDir dist-cloudflare --emptyOutDir && wrangler d1 migrations apply livi --remote && wrangler deploy",
    "convite": "node scripts/convite.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.2.0",
    "@fontsource-variable/jost": "^5.2.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "hono": "^4.13.13",
    "lenis": "^1.3.26",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
