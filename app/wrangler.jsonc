/*
  Loja da Livi na Cloudflare: o mesmo Worker publica o site, guarda as peças
  (banco D1), as fotos (R2) e responde ao painel em /painel.
  Desenvolvimento: "npm run api" (este Worker em localhost:8787) + "npm run dev" (Vite).
  Publicação: "npm run publicar".
*/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "livi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // arquivos do site (JS, CSS, imagens) saem direto, sem passar pelo Worker;
    // o resto (páginas, API, fotos do painel) passa por ele
    "run_worker_first": ["/*", "!/assets/*", "!/img/*", "!/favicon.svg"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "livi",
      "database_id": "bdf89b14-81f4-48dd-9ab3-78b36524db4c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "livi-fotos"
    }
  ],
  // o domínio da loja (a zona livibylm.com.br fica nesta mesma conta da Cloudflare);
  // o workers.dev continua ligado: pedidos antigos mandam o aviso de pagamento para lá
  "routes": [
    { "pattern": "livibylm.com.br", "custom_domain": true },
    { "pattern": "www.livibylm.com.br", "custom_domain": true }
  ],
  "workers_dev": true,
  // SITE_PUBLICO: o endereço do site. Páginas e painel abertos por outro endereço
  // (workers.dev, www, http) vão para lá; a API e as fotos respondem em qualquer um.
  // Vazio = sem redirecionar (o .dev.vars do PC deixa vazio)
  // INFINITEPAY_HANDLE: a InfiniteTag da loja, que recebe os pagamentos do site (sem o $).
  // Uma chave de API, se um dia existir, vai só como segredo: npx wrangler secret put INFINITEPAY_CHAVE
  // Aviso de venda por e-mail (worker/aviso-de-venda.ts): a chave do Resend vai só como segredo: npx wrangler secret put RESEND_CHAVE
  "vars": { "SITE_PUBLICO": "https://livibylm.com.br", "INFINITEPAY_HANDLE": "liviamoraesloureiro" },
  "observability": { "enabled": true }
}
